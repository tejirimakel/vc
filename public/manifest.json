{
  "id": "/?source=pwa",
  "name": "Thevaluechain Live News & Streaming App",
  "short_name": "Thevaluechain",
  "description": "Thevaluechain Live News & Streaming App",
  "start_url": "/",
  "scope": "/",
  "display_override": ["standalone", "minimal-ui"],
  "display": "standalone",
  "orientation": "portrait-primary",
  "categories": ["news", "streaming", "media"],
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/screenshot-mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ],
  "shortcuts": [
    {
      "name": "Latest News",
      "short_name": "News",
      "description": "View the latest news articles",
      "url": "/news",
      "icons": [
        {
          "src": "/icons/news-icon.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Live Streaming",
      "short_name": "Streaming",
      "description": "Watch live streams",
      "url": "/live",
      "icons": [
        {
          "src": "/icons/streaming-icon.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+thevaluechain",
      "url": "/news?query=%s"
    }
  ]
}
